# 多米 API 配置（本地使用，切勿提交到仓库/公开）
DOMI_KEY=            # 多米 API Key
DOMI_BASE_URL=https://duomiapi.com

# 火山 Supabase（本地开发需手动填；部署后由 `iga pages integration` 自动注入为同名环境变量）
SUPABASE_URL=        # 火山 Supabase 项目 URL
SUPABASE_SERVICE_KEY= # service_role key（后端用，绕过 RLS）
SUPABASE_ANON_KEY=    # anon key（前端可用，内部工具一般用 service_role）

# 自建 JWT 签名密钥（随机长字符串：openssl rand -hex 32）
JWT_SECRET=

# 种子管理员（首次启动若无 admin 则插入）
ADMIN_PHONE=
ADMIN_PASSWORD=

# 参考图临时桶（图生图参考图先传这里取 URL，生成后删除；需在 Supabase 建同名 public bucket）
SUPABASE_TEMP_BUCKET=temp-refs

# Phase 8 详情图策划器（腾讯云 TokenHub，hy3/hy-vision 共用）
TOKENHUB_KEY=        # 腾讯云 TokenHub API Key（console.cloud.tencent.com/tokenhub/apikey 创建）
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com
